# Kopieren nach waechter/.env und ausfüllen. Diese Datei NIE ins Git (steht in .gitignore).
# Supabase → Project Settings → API
KF_URL=https://DEIN-PROJEKT.supabase.co
KF_SCHLUESSEL=dein-anon-public-schluessel
# Eigener Benutzer für die Automatik (Supabase → Authentication → Users → Add user),
# als Mitglied mit Rolle „agentur“ und Anzeigename „Claude (Automatik)“ in jedes Projekt eintragen
KF_EMAIL=automatik@deine-domain.de
KF_PASSWORT=langes-zufaelliges-passwort
# Optional: Pfad zu Claude Code, falls „claude“ nicht im PATH liegt
# CLAUDE_BEFEHL=claude

# Name, unter dem die Automatik bei Kunden erscheint (wie in der Tabelle mitglieder)
KF_NAME=Michele (Automatik)

# Zugangsdaten für SFTP-Kunden (je Projekt; Slug groß, Bindestrich wird Unterstrich). Nur hier, nie im Git oder Chat.
# KF_ZIEL_BAECKEREI_MUSTER_PASSWORT=…
# oder mit Schlüsseldatei: KF_ZIEL_BAECKEREI_MUSTER_SCHLUESSEL=C:/Users/du/.ssh/strato
